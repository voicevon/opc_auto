# 临时调试与实验目录 (AGENTS.md 规范：严格隔离，永久忽略)
temp/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 运行日志
*.log

# Chrome CDP 专用 Profile（chrome_cdp_profile，含登录态 Cookie，禁止入库）
data/chrome_cdp_profile/

# 税局同步下载的进项发票原始文件 (PDF/OFD，含敏感财税数据，禁止入库)
data/tax_invoices/

# 联系人台账 (含 909 人手机号等个人隐私数据，禁止入库)
data/contacts.json

# Trae IDE 内部产物 (文档/会话缓存)
.trae/
